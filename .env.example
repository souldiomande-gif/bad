# ---- Twilio (telephony) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# A Twilio number you own, in E.164 format
TWILIO_CALLER_ID=+15551234567

# Public base URL where this server is reachable by Twilio (e.g. an ngrok or prod URL)
PUBLIC_BASE_URL=https://your-app.example.com

# ---- Voice (TTS) ----
# Twilio's built-in neural voices are licensed and require no extra key.
# Pick any Amazon Polly Neural voice id, e.g. Polly.Joanna-Neural, Polly.Matthew-Neural.
VOICE_ID=Polly.Joanna-Neural
VOICE_LANGUAGE=en-US

# ---- Conversation brain (optional) ----
# If unset, the agent falls back to deterministic scripted flows (no LLM calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Company identity used in the mandatory AI disclosure ----
COMPANY_NAME=Your Company
AGENT_NAME=Ava

# ---- Server ----
PORT=3000
